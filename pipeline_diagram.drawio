    <mxCell id="m_qwen35_title" value="🌟 MÔ HÌNH ĐẠI DIỆN CHÍNH: Qwen 3.5 (0.5B / 1.5B)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#311b92;" vertex="1" parent="1">
