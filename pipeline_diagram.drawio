    </mxCell>
    <mxCell id="qwen35_desc" value="• Architecture: Qwen3.5-1.5B-Instruct / QwenCellClassifier&#xa;• Backbone: EfficientNet-B2 + Multimodal Head&#xa;• Training: 30 Epochs, AdamW (lr=3e-4), CosineLR&#xa;• Loss: CrossEntropyLoss (label_smoothing=0.1)&#xa;• Tối ưu cho cả Phân loại &amp; Trích xuất Heatmap XAI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9575cd;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="560" y="170" width="295" height="80" as="geometry" />
    </mxCell>
