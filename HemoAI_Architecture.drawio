        <mxCell id="L86DWDl-ihXZwxzF6TDw-1" edge="1" parent="1" source="step1_yolo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="686.6451612903226" y="577.516129032258" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step1_yolo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;shadow=1;fontSize=11;" value="&lt;b&gt;Bước 1: YOLO26 Detection&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Load: &lt;b&gt;best.pt&lt;/b&gt;&lt;br&gt;• Phát hiện tế bào&lt;br&gt;• Xuất Bounding Boxes&lt;br&gt;• Cắt từng tế bào (Crop)&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="180" x="686.66" y="555" as="geometry" />
        </mxCell>
        <mxCell id="step2_qwen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;shadow=1;fontSize=11;" value="&lt;b&gt;Bước 2: QWen Classification&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Load: Base + LoRA Adapter&lt;br&gt;• Resize crop → 224×224&lt;br&gt;• Prompt-based VQA&lt;br&gt;• Dự đoán: &lt;b&gt;1/12 lớp tế bào&lt;/b&gt;&lt;br&gt;• Confidence Score&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="686.66" y="680" as="geometry" />
        </mxCell>
        <mxCell id="step3_xai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;shadow=1;fontSize=11;" value="&lt;b&gt;Bước 3: XAI Engine&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• &lt;font color=&quot;#D32F2F&quot;&gt;&lt;b&gt;HiResCAM&lt;/b&gt;&lt;/font&gt;: High-Res CAM&lt;br&gt;• &lt;font color=&quot;#1976D2&quot;&gt;&lt;b&gt;XGrad-CAM&lt;/b&gt;&lt;/font&gt;: Axiom-based&lt;br&gt;• &lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;EigenCAM&lt;/b&gt;&lt;/font&gt;: PCA-based&lt;br&gt;• &lt;font color=&quot;#F57C00&quot;&gt;&lt;b&gt;Integrated Gradients&lt;/b&gt;&lt;/font&gt;:&lt;br&gt;  Pixel-level attribution&lt;br&gt;→ Xuất: &lt;b&gt;Heatmap overlay&lt;/b&gt;&lt;/div&gt;" vertex="1">
