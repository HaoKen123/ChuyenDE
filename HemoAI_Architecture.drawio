        <mxCell id="trained_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#4A148C;fontSize=11;fontStyle=0" value="&lt;b&gt;KHỐI 4: MÔ HÌNH ĐÃ&lt;br&gt;HUẤN LUYỆN&lt;/b&gt;&lt;br&gt;(Trained Models / Weights)" vertex="1">
          <mxGeometry height="50" width="170" x="1365" y="105" as="geometry" />
