        <mxCell id="header_train" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d3436;strokeColor=#2d3436;fontStyle=1;fontSize=13;" value="&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;LUỒNG HUẤN LUYỆN (Training Pipeline)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1530" x="80" y="60" as="geometry" />
        </mxCell>
        <mxCell id="ds_bccd_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;dashed=0;" value="" vertex="1">
          <mxGeometry height="350" width="520" x="90" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ds_bccd_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#2E7D32;fontSize=12;fontStyle=1" value="&lt;b&gt;KHỐI 1: TẬP DỮ LIỆU&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="160" x="260" y="105" as="geometry" />
        </mxCell>
        <mxCell id="ds_bccd" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#C8E6C9;strokeColor=#4CAF50;shadow=1;fontSize=11;spacingTop=5;spacingBottom=5;" value="&lt;b&gt;BCCD Dataset&lt;/b&gt;&lt;br&gt;(Blood Cell Count &amp;amp; Detection)&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Tổng: &lt;b&gt;364 ảnh&lt;/b&gt; blood smear&lt;br&gt;• 3 lớp: RBC, WBC, Platelets&lt;br&gt;• Annotation: Bounding Box&lt;br&gt;• Định dạng: YOLO format&lt;br&gt;• Train: &lt;b&gt;205&lt;/b&gt; | Val: &lt;b&gt;87&lt;/b&gt; | Test: &lt;b&gt;72&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="190" x="120" y="140" as="geometry" />
        </mxCell>
        <mxCell id="ds_crop" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#C8E6C9;strokeColor=#4CAF50;shadow=1;fontSize=11;spacingTop=5;spacingBottom=5;" value="&lt;b&gt;Dataset-Crop&lt;/b&gt;&lt;br&gt;(Blood Cell Classification)&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Tổng: &lt;b&gt;45,815 ảnh&lt;/b&gt; tế bào cắt&lt;br&gt;• &lt;b&gt;12 lớp&lt;/b&gt;: BA, BNE, EO, ERB,&lt;br&gt;  LY, MMY, MO, MY, MYO,&lt;br&gt;  PLT, PMY, SNE&lt;br&gt;• Train: &lt;b&gt;32,064&lt;/b&gt; (70%)&lt;br&gt;• Val: &lt;b&gt;6,867&lt;/b&gt; (15%)&lt;br&gt;• Test: &lt;b&gt;6,883&lt;/b&gt; (15%)&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="190" x="380" y="135" as="geometry" />
        </mxCell>
        <mxCell id="preprocess_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="330" width="220" x="680" y="100" as="geometry" />
        </mxCell>
        <mxCell id="preprocess_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#E65100;fontSize=12;fontStyle=0" value="&lt;b&gt;KHỐI 2: TIỀN XỬ LÝ&lt;/b&gt;&lt;br&gt;(Preprocessing - Training)" vertex="1">
          <mxGeometry height="40" width="170" x="705" y="105" as="geometry" />
        </mxCell>
        <mxCell id="pp_yolo_train" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FF9800;shadow=1;fontSize=11;" value="&lt;b&gt;Tiền xử lý YOLO26&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Resize: &lt;b&gt;640×640&lt;/b&gt;&lt;br&gt;• Normalization: [0,1]&lt;br&gt;• Augmentation:&lt;br&gt;  - Horizontal Flip&lt;br&gt;  - Mosaic&lt;br&gt;  - Scale jitter ±50%&lt;br&gt;  - HSV augment&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="695" y="150" as="geometry" />
        </mxCell>
        <mxCell id="pp_qwen_train" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FF9800;shadow=1;fontSize=11;" value="&lt;b&gt;Tiền xử lý QWen&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Resize: &lt;b&gt;224×224&lt;/b&gt;&lt;br&gt;• Normalize: mean=[0.485,&lt;br&gt;  0.456, 0.406]&lt;br&gt;  std=[0.229, 0.224, 0.225]&lt;br&gt;• Augmentation:&lt;br&gt;  - Random Rotation&lt;br&gt;  - Color Jitter&lt;br&gt;  - Random Horizontal Flip&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="190" x="695" y="272.5" as="geometry" />
        </mxCell>
        <mxCell id="model_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="290" width="330" x="960" y="100" as="geometry" />
        </mxCell>
        <mxCell id="model_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#0D47A1;fontSize=11;fontStyle=0" value="&lt;b&gt;KHỐI 3: TRÍCH XUẤT ĐẶC TRƯNG &amp;amp; HUẤN LUYỆN&lt;/b&gt;&lt;br&gt;(Feature Extraction &amp;amp; Training)" vertex="1">
          <mxGeometry height="40" width="270" x="990" y="105" as="geometry" />
        </mxCell>
        <mxCell id="yolo_model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;shadow=1;fontSize=11;" value="&lt;b&gt;YOLO26n&lt;/b&gt;&lt;br&gt;(Object Detection)&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Kiến trúc: One-Stage Detector&lt;br&gt;• Backbone → Neck → Head&lt;br&gt;• Input: 640×640×3&lt;br&gt;• Loss: CIoU + BCE&lt;br&gt;• Optimizer: &lt;b&gt;SGD&lt;/b&gt;&lt;br&gt;  (lr=0.01, momentum=0.937)&lt;br&gt;• Epochs: &lt;b&gt;100&lt;/b&gt;&lt;br&gt;• Batch size: &lt;b&gt;16&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="145" x="975" y="150" as="geometry" />
        </mxCell>
        <mxCell id="qwen_model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;shadow=1;fontSize=11;" value="&lt;b&gt;Qwen2.5-VL-3B&lt;/b&gt;&lt;br&gt;(Vision-Language Model)&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• Base: Qwen2.5-VL-3B-Instruct&lt;br&gt;• Fine-tune: &lt;b&gt;LoRA&lt;/b&gt; (PEFT)&lt;br&gt;• Quantization: &lt;b&gt;4-bit&lt;/b&gt; (QLoRA)&lt;br&gt;• Optimizer: &lt;b&gt;AdamW&lt;/b&gt;&lt;br&gt;  (lr=1e-4, warmup)&amp;nbsp;&lt;br&gt;• Prompt: VQA classification&lt;br&gt;• Output: 12 cell labels&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="145" x="1130" y="150" as="geometry" />
        </mxCell>
        <mxCell id="train_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=9;shadow=1;size=14;" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;⚙️ Hai mô hình được huấn luyện &lt;b&gt;riêng biệt&lt;/b&gt;&lt;br&gt;trên hai tập dữ liệu khác nhau&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="1015" y="310" as="geometry" />
        </mxCell>
        <mxCell id="trained_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="" vertex="1">
