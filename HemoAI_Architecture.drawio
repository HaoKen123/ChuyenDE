        <mxCell id="qwen_weights" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#CE93D8;strokeColor=#7B1FA2;shadow=1;fontSize=11;spacingTop=5;spacingBottom=5;" value="&lt;b&gt;QWen LoRA Adapter&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;• Checkpoint:&amp;nbsp;&lt;b&gt;adapter_model.safetensors&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;• Classify: &lt;/span&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;12 loại tế bào&lt;/b&gt;&lt;/div&gt;" vertex="1">
