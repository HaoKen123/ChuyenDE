  <diagram id="hemoai_full" name="HemoAI - Mô hình đề xuất">
    <mxGraphModel dx="1151" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
