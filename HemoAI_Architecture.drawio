        <mxCell id="yolo_weights" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#CE93D8;strokeColor=#7B1FA2;shadow=1;fontSize=11;spacingTop=5;spacingBottom=5;" value="&lt;b&gt;YOLO26 Weights&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;• File: &lt;b&gt;best.pt&lt;/b&gt;&lt;br&gt;• Detect: RBC, WBC,&lt;br&gt;  Platelets&lt;br&gt;• Output: Bounding Boxes&lt;br&gt;  + Cropped Cells&lt;/div&gt;" vertex="1">
